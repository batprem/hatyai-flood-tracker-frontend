# Hat Yai Flood Watch — frontend environment variables
#
# Copy this file to `.env.local` (or `.env`) and adjust values before running
# `bun run dev`. Bun inlines any literal `process.env.VITE_*` references at
# build/dev time per `bunfig.toml` (`env = "VITE_*"`).

# Public backend base URL. Required in deployed environments.
# Example: https://hatyai-flood-tracker.up.railway.app
VITE_API_URL=

# Optional MapTiler key for higher-quality basemap tiles in BasinMap.
# Leave empty to fall back to the free MapLibre demotiles style. The MapTiler
# Cloud free tier is sufficient for prototyping; review production quotas and
# attribution at https://www.maptiler.com/cloud/ before launch.
VITE_MAPTILER_KEY=
